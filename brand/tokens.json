{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "STYLO design tokens — the single source of colours, type and shape for the app, the website, the back office (STYLO Admin / Store) and the driver screen. Generated into mobile/src/theme and admin CSS (do not hand-copy hex codes). Contrast ratios are WCAG 2.1 against the surface named.",
  "brand": {
    "navy": {
      "$value": "#0B1F2E",
      "$description": "Deep Navy — primary brand colour"
    },
    "teal": {
      "$value": "#355E5A",
      "$description": "Muted Teal — secondary"
    },
    "ivory": {
      "$value": "#F8F6F1",
      "$description": "Soft Ivory — backgrounds"
    },
    "silver": {
      "$value": "#C9C9C9",
      "$description": "Brushed Silver — logo on navy, decoration only (1.5:1 on ivory: never text on light)"
    }
  },
  "color": {
    "primary": {
      "$value": "#0B1F2E",
      "$description": "Buttons, headers, primary text. White on it 16.8:1; on ivory 15.6:1"
    },
    "primaryPressed": {
      "$value": "#13324A",
      "$description": "Pressed / hover state of primary"
    },
    "primaryDeep": {
      "$value": "#071622",
      "$description": "Deepest navy: text on navy tints, hero gradient end"
    },
    "primarySoft": {
      "$value": "#E8ECF0",
      "$description": "Navy tint: selected chips, highlights (navy on it 13.4:1)"
    },
    "secondary": {
      "$value": "#355E5A",
      "$description": "Links, active tab marker, «يصلك اليوم» text. 6.7:1 on ivory; white on it 7.2:1"
    },
    "secondarySoft": {
      "$value": "#E6EFEC",
      "$description": "Teal tint behind delivery badges (teal on it 6.2:1)"
    },
    "background": {
      "$value": "#F8F6F1",
      "$description": "Screen background (ivory)"
    },
    "surface": {
      "$value": "#FFFFFF",
      "$description": "Cards, sheets, inputs on ivory"
    },
    "surfaceMuted": {
      "$value": "#EFEBE0",
      "$description": "Sand: search field, chips, image placeholders"
    },
    "border": {
      "$value": "#E6E1D6",
      "$description": "Hairlines, card borders"
    },
    "borderStrong": {
      "$value": "#C9C4B8",
      "$description": "Input borders, dividers that must be seen"
    },
    "ink": {
      "$value": "#0B1F2E",
      "$description": "Body text (= navy)"
    },
    "inkSecondary": {
      "$value": "#4A5560",
      "$description": "Secondary text — 7.0:1 on ivory"
    },
    "inkMuted": {
      "$value": "#5F6870",
      "$description": "Captions, hints — 5.3:1 on ivory, 4.8:1 on sand"
    },
    "inkFaint": {
      "$value": "#8A9097",
      "$description": "Icons, disabled — 3.0:1: never for text people must read"
    },
    "onPrimary": {
      "$value": "#FFFFFF"
    },
    "silver": {
      "$value": "#C9C9C9",
      "$description": "Text/lines on navy only (10.2:1 on navy)"
    },
    "star": {
      "$value": "#9A6A12",
      "$description": "Rating stars (decorative, champagne gold)"
    },
    "success": {
      "$value": "#2D6A4F",
      "$description": "Confirmations — white on it 6.4:1"
    },
    "successSoft": {
      "$value": "#E3F0E8",
      "$description": "success on it 5.5:1"
    },
    "sale": {
      "$value": "#9E3A2B",
      "$description": "Discount badge «-23%», old price — white on it 6.8:1"
    },
    "saleSoft": {
      "$value": "#F7E6E2",
      "$description": "sale on it 5.6:1"
    },
    "danger": {
      "$value": "#9E3A2B",
      "$description": "Errors (same hue as sale)"
    },
    "dangerSoft": {
      "$value": "#F7E6E2"
    },
    "warning": {
      "$value": "#8A5A00",
      "$description": "Pending / attention — 5.2:1 on warningSoft"
    },
    "warningSoft": {
      "$value": "#FBF0DA"
    },
    "info": {
      "$value": "#355E5A",
      "$description": "Neutral information uses the brand teal"
    },
    "infoSoft": {
      "$value": "#E6EFEC"
    },
    "overlay": {
      "$value": "rgba(11, 31, 46, 0.55)",
      "$description": "Behind dialogs and on photos under text"
    }
  },
  "font": {
    "display": {
      "$value": "Cinzel",
      "weights": [
        500
      ],
      "$description": "STYLO wordmark and store wordmarks only (Latin capitals, tracking 0.30em)"
    },
    "displayEn": {
      "$value": "Playfair Display",
      "weights": [
        400,
        600
      ],
      "$description": "English editorial titles (onboarding, banners) — optional, never for Arabic"
    },
    "body": {
      "$value": "IBM Plex Sans Arabic",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "$description": "All UI text, Arabic and Latin (its Latin is designed to match)"
    },
    "label": {
      "$value": "Montserrat",
      "weights": [
        400,
        500
      ],
      "$description": "Spaced Latin capitals: «MORE THAN FASHION», small overlines"
    }
  },
  "type": {
    "display": {
      "size": 28,
      "lineHeight": 40,
      "weight": 600
    },
    "title": {
      "size": 20,
      "lineHeight": 30,
      "weight": 600
    },
    "heading": {
      "size": 17,
      "lineHeight": 26,
      "weight": 600
    },
    "body": {
      "size": 15,
      "lineHeight": 24,
      "weight": 400
    },
    "bodySm": {
      "size": 13,
      "lineHeight": 20,
      "weight": 400
    },
    "caption": {
      "size": 12,
      "lineHeight": 18,
      "weight": 500
    },
    "overline": {
      "size": 11,
      "lineHeight": 16,
      "weight": 500,
      "tracking": "0.24em",
      "font": "label",
      "$description": "Latin capitals only"
    },
    "price": {
      "size": 16,
      "lineHeight": 24,
      "weight": 600
    }
  },
  "space": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radius": {
    "xs": 2,
    "sm": 4,
    "md": 8,
    "lg": 12,
    "pill": 999,
    "$description": "Sharp, tailored corners: buttons 4, cards 8, sheets 12"
  },
  "border": {
    "hairline": 1,
    "strong": 1.5
  },
  "shadow": {
    "card": {
      "$value": "0 1px 2px rgba(11,31,46,0.04), 0 4px 14px rgba(11,31,46,0.05)"
    },
    "sheet": {
      "$value": "0 -6px 24px rgba(11,31,46,0.10)"
    }
  },
  "motion": {
    "fast": 150,
    "base": 220,
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
