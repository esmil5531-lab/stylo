# ---------------------------------------------------------------- database
# Local PostgreSQL (default):
DATABASE_URL=postgresql://stylo:stylo@localhost:5432/stylo_dev
#
# Supabase — use the SESSION POOLER address (IPv4), not db.<ref>.supabase.co (IPv6-only:
# "getaddrinfo ENOTFOUND" on most networks and on Windows). Dashboard → Connect → Session pooler:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   - the user is postgres.<project-ref> (with the dot), port 5432 (session mode)
#   - special characters in the password must be URL-encoded (@ → %40, # → %23, / → %2F)
#
# SSL is automatic: none for local hosts; encrypted for Supabase/Neon/RDS. Override if needed:
#   DATABASE_SSL=disable | require | verify
#   DATABASE_CA_FILE=C:\path\prod-ca-2021.crt   (Supabase "SSL certificate" download; enables verify)
# Check everything with:  npm run db:check
PORT=4000
HOST=0.0.0.0

# ---------------------------------------------------------------- sign-in codes & notifications
# In development the code is ALSO shown on screen (OTP_DEV_ECHO), whatever the channel.
# Production REQUIRES: OTP_PEPPER (random, 32+ chars) and a real channel (whatsapp or sms_http).
OTP_DEV_ECHO=true
# OTP_PEPPER=change-me-to-a-long-random-secret

# console  = development: nothing is sent (codes on screen, order updates in the log)
# whatsapp = WhatsApp Business Cloud API (main channel)
# sms_http = optional fallback: POSTs { to, text } to SMS_HTTP_URL
MESSAGING_PROVIDER=console

# --- WhatsApp Business Cloud API (Meta) — fill these, then set MESSAGING_PROVIDER=whatsapp
# Permanent token of a System User with whatsapp_business_messaging permission (never commit it).
WHATSAPP_TOKEN=
# "Phone number ID" from WhatsApp Manager → API Setup (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved templates (language ar):
#   stylo_login_code   — category AUTHENTICATION, "copy code" button
#   stylo_order_status — category UTILITY, body: {{1}} name, {{2}} order number, {{3}} status, {{4}} store
WHATSAPP_OTP_TEMPLATE=stylo_login_code
WHATSAPP_ORDER_TEMPLATE=stylo_order_status
WHATSAPP_TEMPLATE_LANG=ar
# Send order status updates to customers (true by default outside tests).
NOTIFY_ORDER_STATUS=true

# --- Optional SMS fallback
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=

# ---------------------------------------------------------------- websites
# The two websites, served by this API after `npm run build` at the repo root:
#   http://localhost:4000/        customer site (and driver mode)
#   http://localhost:4000/admin/  back office (admin, staff, store owners)
CUSTOMER_WEB_DIR=../mobile/dist
ADMIN_WEB_DIR=../admin/dist

# ---------------------------------------------------------------- photos (uploads from the back office)
# Every upload is checked, stripped of EXIF/GPS and saved as WebP in 3 widths (320/800/1600).
# local    = this server's disk (UPLOADS_DIR, default <repo>/uploads), served at /uploads/
# supabase = Supabase Storage: create a PUBLIC bucket named "media" (Storage → New bucket → Public),
#            then copy Project URL and the service_role key (Settings → API). The key stays on the
#            server only — never in the mobile app or the back office.
MEDIA_STORAGE=local
# UPLOADS_DIR=C:\stylo-uploads
# MEDIA_MAX_MB=10
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media
