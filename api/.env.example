DATABASE_URL=postgresql://stylo:stylo@localhost:5432/stylo_dev
PORT=4000
HOST=0.0.0.0

# Sign-in codes: in development the code is shown on screen (no SMS gateway yet).
# Production REQUIRES: OTP_PEPPER (random, 32+ chars), SMS_PROVIDER=http and SMS_HTTP_URL.
OTP_DEV_ECHO=true
SMS_PROVIDER=console

# The two websites, served by this API after `npm run build` at the repo root:
#   http://localhost:4000/        customer site
#   http://localhost:4000/admin/  back office (admin, staff, store owners)
CUSTOMER_WEB_DIR=../mobile/dist
ADMIN_WEB_DIR=../admin/dist
