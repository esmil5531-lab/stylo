# Copy to mobile/.env (not committed) — Expo reads EXPO_PUBLIC_* variables at bundle time.
# After any change, restart Metro with a clean cache:  npx expo start --lan -c
#
# Address of the Stylo API (npm --prefix api run dev, port 4000) as the PHONE sees it:
#   - phone on the same Wi-Fi: the computer's LAN IP (PowerShell: ipconfig → IPv4 Address)
#   - Android emulator: http://10.0.2.2:4000/v1   - iOS simulator: http://localhost:4000/v1
#   - store builds: https://<your-domain>/v1
# Leave it unset to use the computer running Metro automatically (LAN mode).
# The customer WEBSITE ignores this and always uses its own origin.
EXPO_PUBLIC_API_URL=http://10.19.26.252:4000/v1

# «تواصل معنا» in the account screen: Stylo's customer-service WhatsApp number (hidden when empty).
# EXPO_PUBLIC_SUPPORT_WHATSAPP=0912345678
