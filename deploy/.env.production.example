# Settings of the Stylo app in production (deploy/.env.production). Never commit the real file.
NODE_ENV=production
LOG_LEVEL=info

# The public https address (canonical links, sitemap, link previews). Must match DOMAIN in .env.
PUBLIC_SITE_URL=https://stylo.ly
# Google Search Console → Settings → Ownership verification → HTML tag → the "content" value.
GOOGLE_SITE_VERIFICATION=
# Indexing is on by default in production. Set false for a staging server.
# SEO_INDEXING=true

# Random, 32+ characters (e.g. `openssl rand -hex 32`). Changing it invalidates pending codes.
OTP_PEPPER=

# WhatsApp Business Cloud API (Meta) — see api/.env.example for the two templates.
MESSAGING_PROVIDER=whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=stylo_login_code
WHATSAPP_ORDER_TEMPLATE=stylo_order_status
WHATSAPP_TEMPLATE_LANG=ar

# Delivery
EXPRESS_SURCHARGE=5000
STANDARD_DELAY_HOURS=24

# Photos uploaded from the back office. "local" keeps them in the `uploads` volume (back it up!);
# "supabase" stores them in a public Supabase Storage bucket (see docs/SUPABASE.md).
MEDIA_STORAGE=local
# MEDIA_MAX_MB=10
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media
